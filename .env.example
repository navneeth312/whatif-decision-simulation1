# Optional online WhatIf AI Scenario Agent.
# Create a key in Google AI Studio (free-tier project), then store it in
# your private .env.local file or Vercel Environment Variables.
# Do NOT prefix this key with VITE_ and never commit .env.local.
# The server keeps this key completely out of client-side browser code.
GEMINI_API_KEY="PASTE_YOUR_FREE_TIER_KEY_HERE"

# Optional server port (defaults to 3000 for local development).
PORT=3000

# Optional trusted reverse-proxy hops (defaults to 1 for Vercel/cloud proxies, 0 for bare local).
WHATIF_TRUST_PROXY_HOPS=1
